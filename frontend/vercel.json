{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REPLACE-WITH-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/generated/:path*",
      "destination": "https://REPLACE-WITH-AI-SERVICE.hf.space/generated/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
